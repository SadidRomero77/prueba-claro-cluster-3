# Copiar a .env y completar. Sin claves, todo funciona en modo offline (reglas).

# --- LLM para clasificación de llamadas y agentes ---
# Proveedor: openrouter | anthropic | openai | databricks
LLM_PROVIDER=openrouter
# Vacío = default del proveedor (ver src/cluster3/llm.py). En OpenRouter: proveedor/modelo, p. ej. anthropic/claude-sonnet-5
LLM_MODEL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Databricks (Foundation Model APIs). En Databricks Apps ya vienen del entorno.
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# --- Jev (TypeSafe AI) ---
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# --- MLflow (opcional; vacío = ./mlruns) ---
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=cluster3_churn

# --- Despliegue AWS (deploy/aws) ---
APP_DOMAIN=
APP_USER=claro
# Hash de: docker run --rm caddy:2 caddy hash-password --plaintext 'la-clave' (entre comillas simples)
APP_PASSWORD_HASH=''
